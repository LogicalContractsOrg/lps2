// discount.drl — a rule base in the shape enterprise Drools actually takes:
// facts about a customer, a rule that classifies, and a rule that acts on the
// classification. Two rules with a salience, so the transpiler has something
// to report about (§IV.2: salience is an operational device, and LPS has no
// equivalent).

declare Customer
    name : String
    tier : String
end

declare Order
    customer : String
    size : String
end

declare Discount
    customer : String
    rate : String
end

rule "Gold customers with a large order get the best rate"
    salience 10
    when
        Order( customer : customer, size == large )
        Customer( name == customer, tier == gold )
        not Discount( customer == customer )
    then
        insert(new Discount(customer, best))
end

rule "Everyone else with a large order gets the standard rate"
    salience 5
    when
        Order( customer : customer, size == large )
        not Customer( name == customer, tier == gold )
        not Discount( customer == customer )
    then
        insert(new Discount(customer, standard))
end
