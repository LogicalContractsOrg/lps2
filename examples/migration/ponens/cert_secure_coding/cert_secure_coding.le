    %     cert_recommendation_departure_recorded: failed at step 2
    %     cert_rule_violation_remediated: failed at step 1
    %     cert_static_analysis_before_commit: failed at step 5
    %     cert_undecidable_manual_review: failed at step 3
    the trace shows "a commit" from 1 to 2.
    step 1 shows "level l1" from 2 to 3.
    step 1 is a Finding from 2 to 3.
    step 1 shows "priority assigned" from 2 to 3.
    step 1 shows "severity assessed" from 2 to 3.
    step 1 shows "likelihood assessed" from 2 to 3.
    step 1 shows "remediation assessed" from 2 to 3.
    step 1 shows "cert rule violation" from 2 to 3.
    step 1 ends from 3 to 4.
    step 2 shows "level l2" from 4 to 5.
    step 2 is a Finding from 4 to 5.
    step 2 shows "priority assigned" from 4 to 5.
    step 2 shows "cert recommendation departure" from 4 to 5.
    step 2 shows "severity assessed" from 4 to 5.
    step 2 shows "likelihood assessed" from 4 to 5.
    step 2 shows "remediation assessed" from 4 to 5.
    step 2 ends from 5 to 6.
    step 3 shows "undecidable violation" from 6 to 7.
