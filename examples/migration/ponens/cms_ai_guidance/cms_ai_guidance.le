    %     cms_ai_provenance_verified: failed at step 5
    %     cms_continuous_human_oversight: failed at step 2
    %     cms_data_residency: failed at step 4
    %     cms_high_impact_human_final_decision: failed at step 1
    %     cms_high_impact_risk_assessed: failed at step 1
    %     cms_production_observability: failed at step 2
    %     cms_prompts_versioned: failed at step 2
    %     cms_records_retention: failed at step 7
    %     cms_sensitive_data_compliant_tool: failed at step 3
    %     cms_zero_trust_for_ai: failed at step 6
    step 1 shows "high impact decision" from 2 to 3.
    step 1 shows "high impact ai" from 2 to 3.
    step 1 ends from 3 to 4.
    step 2 is a Deploy from 4 to 5.
    step 2 shows "production ai" from 4 to 5.
    step 2 ends from 5 to 6.
    step 3 shows "sensitive data use" from 6 to 7.
    step 3 ends from 7 to 8.
    step 4 shows "foreign ai" from 8 to 9.
    step 4 ends from 9 to 10.
    step 5 shows "ai component" from 10 to 11.
    step 5 ends from 11 to 12.
    step 6 shows "ai outbound capable" from 12 to 13.
    step 6 ends from 13 to 14.
    step 7 shows "ai supported action" from 14 to 15.
    step 7 ends from 15 to 16.
    the session ends from 16 to 17.
