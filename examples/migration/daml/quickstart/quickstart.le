% Daml (the script run on a Canton sandbox) ends with these active contracts (their payloads;
% the ids are the ledger's):
%   - iou('acme bank',alice,"EUR",60.0,[])
%   - iou('acme bank',alice,"USD",60.0,[])
%   - iou('acme bank',bob,"USD",70.0,[])
% The twin's final state under LPS2 (`lps state`) is compared with it by test_daml.pl.
scenario iou_test is:
    % the Daml Script iou_test
    acme bank creates the iou iou_transfer_alice_cid_iou with issuer acme bank, owner acme bank, currency "USD", amount 100.0 and observers party list [] from 1 to 2.
    acme bank exercises transfer on the iou iou_transfer_alice_cid_iou with new owner alice creating iou_transfer_alice_cid from 2 to 3.
    acme bank creates the iou iou_transfer_bob_cid_iou with issuer acme bank, owner acme bank, currency "USD", amount 30.0 and observers party list [] from 3 to 4.
    acme bank exercises transfer on the iou iou_transfer_bob_cid_iou with new owner bob creating iou_transfer_bob_cid from 4 to 5.
    alice exercises accept on the iou transfer iou_transfer_alice_cid creating iou_alice_cid from 5 to 6.
    bob exercises accept on the iou transfer iou_transfer_bob_cid creating iou_bob_cid from 6 to 7.
    alice exercises split on the iou iou_alice_cid with split amount 40.0 creating split_1 and split_2 from 7 to 8.
    alice exercises transfer on the iou split_1 with new owner bob creating iou_transfer_cid from 8 to 9.
    bob exercises accept on the iou transfer iou_transfer_cid creating iou_other_cid from 9 to 10.
    bob exercises merge on the iou iou_bob_cid with other cid iou_other_cid creating iou_total_cid from 10 to 11.
    acme bank creates the iou iou_bank_cid with issuer acme bank, owner acme bank, currency "USD", amount 100.0 and observers party list [] from 11 to 12.
    acme bank archives the iou iou_bank_cid from 12 to 13.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    alice creates the iou c1 with issuer acme bank, owner alice, currency "USD", amount 50.0 and observers party list [] from 13 to 14.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank creates the iou c2 with issuer acme bank, owner alice, currency "USD", amount -20.0 and observers party list [] from 14 to 15.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank creates the iou c3 with issuer acme bank, owner alice, currency "USD", amount -20.0 and observers party list [] from 15 to 16.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    alice exercises split on the iou split_2 with split amount 80.0 creating c4 and c5 from 16 to 17.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    alice exercises transfer on the iou split_1 with new owner charlie creating c6 from 17 to 18.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank exercises transfer on the iou iou_other_cid with new owner charlie creating c7 from 18 to 19.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank exercises transfer on the iou split_2 with new owner charlie creating c8 from 19 to 20.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank archives the iou split_1 from 20 to 21.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    acme bank archives the iou split_2 from 21 to 22.
    acme bank creates the iou iou_transfer_eurcid_iou with issuer acme bank, owner acme bank, currency "EUR", amount 60.0 and observers party list [] from 22 to 23.
    acme bank exercises transfer on the iou iou_transfer_eurcid_iou with new owner alice creating iou_transfer_eurcid from 23 to 24.
    alice exercises accept on the iou transfer iou_transfer_eurcid creating iou_eurcid from 24 to 25.
    % Daml refuses the next command (submitMustFail): the twin's integrity constraints refuse it
    alice exercises merge on the iou split_2 with other cid iou_eurcid creating c9 from 25 to 26.

