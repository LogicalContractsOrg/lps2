// shipping.drl — retract as well as insert.
//
// Provenance: the "order fulfilment" shape used throughout the Drools manual's
// working-memory chapter. Chosen because it exercises `retract`, which the
// other examples here do not, and because retraction is where a production
// system and LPS differ most: Drools removes a fact, LPS *terminates a
// fluent*, and the trace records which causal law did it.

declare Order
    id : String
    state : String
end

declare Stock
    item : String
    level : String
end

declare Shipment
    order : String
end

rule "an order with stock ships"
    when
        o : Order( id : id, state == placed )
        s : Stock( level == available )
    then
        insert(new Shipment(id))
        modify( o ) { state = shipped }
        modify( s ) { level = low }
end

rule "a shipped order is no longer pending"
    when
        o : Order( id : id, state == shipped )
        Shipment( order == id )
    then
        retract( o )
end
