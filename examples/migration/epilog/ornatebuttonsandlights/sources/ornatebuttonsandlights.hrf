%%% goal
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

goal(robot,100) :- p & q & r
goal(robot,50) :- p & q & ~r
goal(robot,50) :- p & ~q & r
goal(robot,50) :- ~p & q & r
goal(robot,25) :- p & ~q & ~r
