succ(25,26)
succ(26,27)
succ(27,28)
succ(28,29)
succ(29,30)
succ(30,31)
succ(31,32)
succ(31,33)

add1row(1,2)
add1row(2,3)
add1row(3,4)
add1row(4,5)
add2row(1,3)
add2row(2,4)
add2row(3,5)
add1col(1,2)
add1col(2,3)
add2col(1,3)

scoremap(0,0)
scoremap(1,1)
scoremap(2,3)
scoremap(3,7)
