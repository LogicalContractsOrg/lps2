the nextrank of 2 is 3.

the nextrank of 3 is 4.

the nextrank of 4 is 5.

the nextrank of 5 is 6.

the nextrank of 6 is 7.

the nextrank of 7 is 8.

the nextrank of 8 is 1.

"a" is the nextfile of b.

b is the nextfile of c.

c is the nextfile of d.

d is the nextfile of "a".

red home b with 8.

red home d with 8.

red home "a" with 7.

red home c with 7.

red home b with 6.

red home d with 6.

blue home b with 3.

blue home d with 3.

blue home "a" with 2.

blue home c with 2.

blue home b with 1.

blue home d with 1.

