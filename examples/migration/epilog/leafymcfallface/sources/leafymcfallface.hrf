%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% metadata
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

role(red)
role(blue)

opp(red,blue)
opp(blue,red)

base(leaf(X,Y)) :- index(X) & index(Y)
base(isplayer(X,Y,R)) :- index(X) & index(Y) & role(R)
base(control(R)) :- role(R)

action(move(X,Y)) :- index(X) & index(Y)

index(1)
index(2)
index(3)
index(4)
index(5)
index(6)
index(7)

