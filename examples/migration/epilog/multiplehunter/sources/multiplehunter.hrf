succ(13,14)
succ(14,15)
succ(15,16)

add1row(1,2)
add1row(2,3)
add1row(3,4)
add1row(4,5)
add2row(1,3)
add2row(2,4)
add2row(3,5)

add1col(1,2)
add1col(2,3)
add2col(1,3)

scoremap(0,0)
scoremap(1,1)
scoremap(2,3)
scoremap(3,7)
scoremap(4,11)
