% Companion file to loan_agreement.le (docs/user/reference/le-for-lps.md §7): the
% real-time settings and the calendar library. Not statements about the loan.

:- include(system('date_utils.pl')).     % gives us end_of_day(Date)

simulatedRealTimeBeginning('2014-05-31').
simulatedRealTimePerCycle(RTPC) :- minCycleTime(RTPC).

maxRealTime(189216000).                  % six years, the statute of limitations
minCycleTime(21600).                     % four cycles per calendar day
