%  Where the cell at (X, Y) of grid 1 is drawn: its centre. North is up.
lps_grid_1(X, Y, CX, CY) :-
	number(X), number(Y),
	CX is 0.00 + (X - 1 + 0.5) * 30,
	CY is 0.00 + (Y - 0 + 0.5) * 30.

%  What each thing looks like. `icon:` names one of the built-in icons
%  (Help ▸ About the icons, fills and objects); the colour is used by the
%  box and circle shapes.
lps_look(mycar, box, '#4c8dff').
lps_look(yourcar, box, '#e5484d').
lps_look(othercar, box, '#30a46c').
lps_look(troubleMaker, box, '#b8336a').
lps_look(brokencar, box, '#8b94a6').

%  …and what its surface is like, and what it is in three dimensions:
%  a fill from the pattern library and an object from the 3D catalogue
%  (Help ▸ About the icons, fills and objects lists both). `none` is a
%  plain shape: the renderers ignore a name they do not have.
lps_style(mycar, none, none).
lps_style(yourcar, none, none).
lps_style(othercar, none, none).
lps_style(troubleMaker, none, none).
lps_style(brokencar, none, none).

