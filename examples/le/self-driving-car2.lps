% The visual mapping for self-driving-car2.le, in LPS external syntax.
% self-driving-car2.le and self-driving-car2.lps compile together (docs/user/reference/le-for-lps.md §7).

%  Scene generated by the LPS2 assistant: the plan was the model's,
%  the geometry is this file's (src/edges/lps_scene.pl). The model
%  never writes a coordinate.

display(location(What, GX-GY, _), [type:circle, center:[CX, CY], radius:13.00,
		     fillColor:Colour, label:What]) :-
	lps_grid_1(GX, GY, CX, CY),
	lps_look(What, _, Colour).


