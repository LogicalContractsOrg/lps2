% alice.lps — the words of alice.le: Carroll's, where he wrote them, and a few
% joins. `description/2` is what `look` says of a room; `narrate/2` is what an
% action says instead of its template, and `none` says nothing. The logic is
% all in the English document; nothing here changes what happens.

description(riverbank,
  "You are sitting by your sister on the bank, and having nothing to do. Once or twice you have peeped into the book your sister is reading, but it has no pictures or conversations in it, and what is the use of a book without pictures or conversations?").
description(rabbit_hole,
  "The rabbit-hole goes straight on like a tunnel for some way, and then dips suddenly down, so suddenly that you have not a moment to think about stopping yourself before you find yourself falling down what seems to be a very deep well.").
description(hall,
  "A long, low hall, lit up by a row of lamps hanging from the roof. There are doors all round the hall, but they are all locked; in the middle stands a little three-legged table, all made of solid glass. Behind a low curtain is a little door about fifteen inches high, leading south.").
description(garden,
  "The loveliest garden you ever saw: beds of bright flowers and cool fountains. The book's Alice never got here in chapter two.").
description(pool_of_tears,
  "Salt water, up to your chin: the pool of tears you wept when you were nine feet high. Something is splashing about a little way off.").

narrate(run(white_rabbit, offstage, riverbank),
  "A White Rabbit with pink eyes runs close by you. \"Oh dear! Oh dear! I shall be late!\" it says, and takes a watch out of its waistcoat-pocket, and looks at it, and hurries on.").
narrate(run(white_rabbit, riverbank, rabbit_hole),
  "Burning with curiosity, you watch the Rabbit pop down a large rabbit-hole under the hedge.").
narrate(run(white_rabbit, rabbit_hole, hall),
  "Far below, the Rabbit scurries away down the passage.").
narrate(run(white_rabbit, hall, garden),
  "The White Rabbit is no longer to be seen; only its footsteps, going south.").
narrate(run(white_rabbit, garden, hall),
  "A pattering of little feet: the White Rabbit returns, splendidly dressed, with a pair of white kid gloves in one hand and a large fan in the other.").
narrate(drop(white_rabbit, fan),
  "The Rabbit starts violently, drops the white kid gloves and the fan, and skurries away into the darkness as hard as it can go.").
narrate(drop(white_rabbit, gloves), none).

narrate(go(player, down), Text) :-
  description(rabbit_hole, D),
  format(string(Text), "You follow it down. ~w", [D]).

narrate(drink(player, bottle),
  "The bottle has a paper label with the words DRINK ME beautifully printed on it in large letters. It has a sort of mixed flavour of cherry-tart, custard, pine-apple, roast turkey, toffee, and hot buttered toast. \"What a curious feeling!\" you say. \"I must be shutting up like a telescope.\" And so you are: you are now only ten inches high.").
narrate(eat(player, cake),
  "The cake has the words EAT ME beautifully marked in currants. \"Curiouser and curiouser!\" you cry; \"now I'm opening out like the largest telescope that ever was! Good-bye, feet!\" Your head strikes the roof of the hall: you are now nine feet high.").
narrate(cry(player),
  "\"You ought to be ashamed of yourself,\" you say, \"a great girl like you, to go on crying in this way!\" But you go on all the same, shedding gallons of tears, until there is a large pool all round you, about four inches deep and reaching half down the hall.").
narrate(wave(player, fan),
  "You fan yourself as you talk. \"Dear, dear! How queer everything is to-day!\" — and you are shrinking rapidly: you drop the fan just in time to avoid shrinking away altogether.").
narrate(fall(player, pool_of_tears),
  "Your foot slips, and in another moment, splash! you are up to your chin in salt water. \"I wish I hadn't cried so much!\"").
narrate(take(player, golden_key),
  "You take the tiny golden key.").
narrate(refuse_take(player, golden_key),
  "You cannot possibly reach it: the key is on the table, far above your head, and the legs of the table are much too slippery to climb.").
narrate(unlock(player, small_door, golden_key),
  "The key fits! You unlock the little door.").
narrate(go(player, south),
  "You creep through the little door, along the small passage, and out into the loveliest garden you ever saw.").
narrate(initiate(playing(chapter_two)),
  "— CHAPTER II. The Pool of Tears —").
narrate(initiate(ended(chapter_two, wet)),
  "A Mouse is swimming beside you, and you have a great deal to say to it. *** The end of chapter II ***").
narrate(initiate(ended(chapter_two, in_the_garden)),
  "You are in the garden, small and with the key in your pocket, which is not how the book goes at all. *** The end of chapter II, differently ***").
