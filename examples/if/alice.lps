% alice.lps — the words of alice.le: Carroll's, where he wrote them, and a few
% joins. `description/2` is what `look` says of a room; `narrate/2` is what an
% action says instead of its template, and `none` says nothing. The logic is
% all in the English document; nothing here changes what happens.

description(riverbank,
  "You are sitting by your sister on the bank, and having nothing to do. Once or twice you have peeped into the book your sister is reading, but it has no pictures or conversations in it, and what is the use of a book without pictures or conversations?").
description('the rabbit hole',
  "The rabbit-hole goes straight on like a tunnel for some way, and then dips suddenly down, so suddenly that you have not a moment to think about stopping yourself before you find yourself falling down what seems to be a very deep well.").
description(hall,
  "A long, low hall, lit up by a row of lamps hanging from the roof. There are doors all round the hall, but they are all locked; in the middle stands a little three-legged table, all made of solid glass. Behind a low curtain is a little door about fifteen inches high, leading south.").
description(garden,
  "The loveliest garden you ever saw: beds of bright flowers and cool fountains. The book's Alice never got here in chapter two.").
description('the pool of tears',
  "Salt water, up to your chin: the pool of tears you wept when you were nine feet high. Something is splashing about a little way off.").

narrate(run('the white rabbit', offstage, riverbank),
  "A White Rabbit with pink eyes runs close by you. \"Oh dear! Oh dear! I shall be late!\" it says, and takes a watch out of its waistcoat-pocket, and looks at it, and hurries on.").
narrate(run('the white rabbit', riverbank, 'the rabbit hole'),
  "Burning with curiosity, you watch the Rabbit pop down a large rabbit-hole under the hedge.").
narrate(run('the white rabbit', 'the rabbit hole', hall),
  "Far below, the Rabbit scurries away down the passage.").
narrate(run('the white rabbit', hall, garden),
  "The White Rabbit is no longer to be seen; only its footsteps, going south.").
narrate(run('the white rabbit', garden, hall),
  "A pattering of little feet: the White Rabbit returns, splendidly dressed, with a pair of white kid gloves in one hand and a large fan in the other.").
narrate(drop('the white rabbit', fan),
  "The Rabbit starts violently, drops the white kid gloves and the fan, and skurries away into the darkness as hard as it can go.").
narrate(drop('the white rabbit', gloves), none).

narrate(go(player, down), Text) :-
  description('the rabbit hole', D),
  format(string(Text), "You follow it down. ~w", [D]).

narrate(drink(player, bottle),
  "The bottle has a paper label with the words DRINK ME beautifully printed on it in large letters. It has a sort of mixed flavour of cherry-tart, custard, pine-apple, roast turkey, toffee, and hot buttered toast. \"What a curious feeling!\" you say. \"I must be shutting up like a telescope.\" And so you are: you are now only ten inches high.").
narrate(eat(player, cake),
  "The cake has the words EAT ME beautifully marked in currants. \"Curiouser and curiouser!\" you cry; \"now I'm opening out like the largest telescope that ever was! Good-bye, feet!\" Your head strikes the roof of the hall: you are now nine feet high.").
narrate(cry(player),
  "\"You ought to be ashamed of yourself,\" you say, \"a great girl like you, to go on crying in this way!\" But you go on all the same, shedding gallons of tears, until there is a large pool all round you, about four inches deep and reaching half down the hall.").
narrate(wave(player, fan),
  "You fan yourself as you talk. \"Dear, dear! How queer everything is to-day!\" — and you are shrinking rapidly: you drop the fan just in time to avoid shrinking away altogether.").
narrate(fall(player, 'the pool of tears'),
  "Your foot slips, and in another moment, splash! you are up to your chin in salt water. \"I wish I hadn't cried so much!\"").
narrate(take(player, 'the golden key'),
  "You take the tiny golden key.").
narrate(refuse_take(player, 'the golden key'),
  "You cannot possibly reach it: the key is on the table, far above your head, and the legs of the table are much too slippery to climb.").
narrate(unlock(player, 'the small door', 'the golden key'),
  "The key fits! You unlock the little door.").
narrate(go(player, south),
  "You creep through the little door, along the small passage, and out into the loveliest garden you ever saw.").
narrate(initiate(playing('the second chapter')),
  "— CHAPTER II. The Pool of Tears —").
narrate(initiate(ended('the second chapter', wet)),
  "A Mouse is swimming beside you, and you have a great deal to say to it. *** The end of chapter II ***").
narrate(initiate(ended('the second chapter', 'in the garden')),
  "You are in the garden, small and with the key in your pocket, which is not how the book goes at all. *** The end of chapter II, differently ***").

% ---- how the story is drawn: display/2 and display3d/2 ------------------
% Generated 2026-09-04 by a language model (openai/gpt-oss-120b, via Groq)
% asked, through LPS2's own LLM client, for a drawing of the story's fluents
% — the same request the IDE's "Animate in 2D" and "Animate in 3D" make.
% A model's answer is not deterministic: asking again gives a different
% layout, different colours, sometimes different choices of what to draw.
% Nothing here changes what happens in the story; it says how it is shown.
% Regenerate, or edit by hand, as you please.

% -------------------------------------------------
% 2‑D display predicates
% -------------------------------------------------

% ----- background: rooms as labelled rectangles -----------------
display(timeless, Divisions) :-
    findall([type:rectangle, label:Room,
            from:[X,Y], to:[TX,TY],
            strokeColor:black],
            ( room_location(Room,X,Y),
              TX is X + 120,
              TY is Y + 80 ),
            Divisions).

% ----- generic offset table (2‑D) -----------------
thing_offset(player,      10, 40).
thing_offset(sister,      30, 40).
thing_offset('the white rabbit',50, 40).
thing_offset(mouse,       70, 40).
thing_offset('the golden key',  20, 20).
thing_offset(bottle,      40, 20).
thing_offset(cake,        60, 20).
thing_offset('the glass table', 10, 10).
thing_offset(_, 0, 0).                     % catch‑all

% ----- colour mapping (2‑D) -----------------
object_color(player,        '#ffcc99').
object_color(sister,        '#ffcc99').
object_color('the white rabbit', '#ff6666').
object_color(mouse,         '#9999ff').
object_color('the golden key',   '#ffd700').
object_color(bottle,       '#66ccff').
object_color(cake,         '#ff99ff').
object_color('the glass table',  '#cccccc').
object_color(_,            '#dddddd').

% ----- things (or persons) that are IN a room -----------------
display(in(Obj,Room),
        [type:ellipse, label:Obj,
         point:[PX,PY],
         size:[30,30],
         fillColor:Color]) :-
    state(in(Obj,Room)),
    room_location(Room,RX,RY),
    thing_offset(Obj,DX,DY),
    PX is RX + DX,
    PY is RY + DY,
    object_color(Obj,Color).

% ----- things that are ON a supporter -----------------
display(on(Thing,Support),
        [type:ellipse, label:Thing,
         point:[PX,PY],
         size:[20,20],
         fillColor:'#bbbbbb']) :-
    state(on(Thing,Support)),
    (   state(in(Support,Room))
    ;   state(on(Support,_)),            % fallback, unlikely here
        state(in(Support,Room)) ),
    room_location(Room,RX,RY),
    thing_offset(Thing,DX,DY),
    PX is RX + DX + 20,                   % a little offset from the supporter
    PY is RY + DY + 20.

% ----- carries relation (small labelled circle beside carrier) ----------
display(carries(Carrier,Item),
        [type:circle, label:Item,
         point:[PX,PY],
         radius:8,
         fillColor:'#88aa88']) :-
    state(carries(Carrier,Item)),
    state(in(Carrier,Room)),
    room_location(Room,RX,RY),
    thing_offset(Carrier,DX,DY),
    PX is RX + DX + 40,
    PY is RY + DY.

% ----- size fluent (displayed as a tiny text label near the person) -----
display(size(Person,Size),
        [type:text, point:[PX,PY],
         content:Size,
         fontSize:10,
         fillColor:black]) :-
    state(size(Person,Size)),
    state(in(Person,Room)),
    room_location(Room,RX,RY),
    thing_offset(Person,DX,DY),
    PX is RX + DX + 5,
    PY is RY + DY + 5.

% -------------------------------------------------
% 3‑D display predicates
% -------------------------------------------------

% ----- background and room slabs (single timeless clause) -----
display3d(timeless,
    [ [type:ground, size:[40,40], color:'#23262e'],
      [type:camera, position:[0,22,30], lookAt:[0,0,0]],
      [type:light, position:[10,20,10], intensity:1.2]
      | RoomObjs]) :-
    % room slabs
    findall([type:box, size:[8,0.2,8],
            position:[X,0,Z],
            color:'#dddddd',
            label:Room],
            ( room_grid(Room,X,Z) ),
            Slabs),
    % room labels (as 3‑D text)
    findall([type:text, position:[X,0.3,Z],
            label:Room, scale:0.5],
            ( room_grid(Room,X,Z) ),
            Labels),
    append(Slabs, Labels, RoomObjs).

% ----- generic offset table (3‑D) -----------------
thing_offset3d(player,      1, 1).
thing_offset3d(sister,      2, 1).
thing_offset3d('the white rabbit',3, 1).
thing_offset3d(mouse,       4, 1).
thing_offset3d('the golden key',  0.5,0.5).
thing_offset3d(bottle,      1.5,0.5).
thing_offset3d(cake,        2.5,0.5).
thing_offset3d('the glass table', 0, 0).
thing_offset3d(_, 0, 0).                     % catch‑all

% ----- colour mapping (3‑D) -----------------
object_color3d(player,        '#ffcc99').
object_color3d(sister,        '#ffcc99').
object_color3d('the white rabbit', '#ff6666').
object_color3d(mouse,         '#9999ff').
object_color3d('the golden key',   '#ffd700').
object_color3d(bottle,       '#66ccff').
object_color3d(cake,         '#ff99ff').
object_color3d('the glass table',  '#cccccc').
object_color3d(_,            '#dddddd').

% ----- things (or persons) that are IN a room -----------------
display3d(in(Obj,Room),
        [type:box, position:[X,0.7,Z],
         size:[1,1,1],
         color:Color,
         label:Obj]) :-
    state(in(Obj,Room)),
    room_grid(Room,RX,RZ),
    thing_offset3d(Obj,DX,DZ),
    X is RX + DX,
    Z is RZ + DZ,
    object_color3d(Obj,Color).

% ----- things that are ON a supporter -----------------
display3d(on(Thing,Support),
        [type:box, position:[X,0.7,Z],
         size:[1,1,1],
         color:'#bbbbbb',
         label:Thing]) :-
    state(on(Thing,Support)),
    (   state(in(Support,Room))
    ;   state(on(Support,_)),
        state(in(Support,Room)) ),
    room_grid(Room,RX,RZ),
    thing_offset3d(Thing,DX,DZ),
    X is RX + DX + 1,          % beside the supporter
    Z is RZ + DZ.

% ----- carries relation (small sphere beside carrier) ----------
display3d(carries(Carrier,Item),
        [type:sphere, position:[X,0.7,Z],
         radius:0.3,
         color:'#88aa88',
         label:Item]) :-
    state(carries(Carrier,Item)),
    state(in(Carrier,Room)),
    room_grid(Room,RX,RZ),
    thing_offset3d(Carrier,DX,DZ),
    X is RX + DX + 2,
    Z is RZ + DZ.

% -------------------------------------------------
% Helper predicates: fixed room positions (2‑D) -----------------
room_location(riverbank,   50, 250).
room_location('the rabbit hole', 250,250).
room_location(hall,        150,100).
room_location(garden,      150,-50).
room_location('the pool of tears',150,-150).

% Helper predicates: fixed room positions on the 3‑D grid -----------------
room_grid(riverbank,   -10, -10).
room_grid('the rabbit hole',   0, -10).
room_grid(hall,        -10,  0).
room_grid(garden,        0,  0).
room_grid('the pool of tears',-10, 10).
