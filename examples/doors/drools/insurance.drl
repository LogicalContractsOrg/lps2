// insurance.drl — eligibility, the classic rule-engine subject.
//
// Provenance: the shape of the "insurance policy" tutorials that ship with
// Drools and Red Hat's decision-manager documentation. Restated with atoms
// instead of Java types so that nothing here needs a JVM.
//
// The point for LPS: `not` over a pattern is the same operator in both
// languages, and it is what makes "no discount has been given yet" expressible
// without a flag.

declare Driver
    name : String
    age : String
    record : String
end

declare Policy
    driver : String
    band : String
end

rule "young drivers are high risk"
    when
        Driver( name : name, age == young )
        not Policy( driver == name )
    then
        insert(new Policy(name, high))
end

rule "a clean record over thirty is low risk"
    when
        Driver( name : name, age == mature, record == clean )
        not Policy( driver == name )
    then
        insert(new Policy(name, low))
end

rule "a claim moves a low band to standard"
    when
        Driver( name : name, record == claimed )
        p : Policy( driver == name, band == low )
    then
        modify( p ) { band = standard }
end
