// fire-alarm.drl — the fire/sprinkler/alarm rule base from the Drools manual,
// in the shape a Drools user would write it.
//
// It is the smallest rule base that exercises the four things a production
// system does to working memory — match, insert, retract and modify — plus a
// `not` pattern, which is where LPS and Drools agree most exactly.
//
// LPS2 reads it as the world it describes (src/syntax/lps_drools.pl): a fire
// in a room, a sprinkler that turns on, an alarm that goes on — with the
// words and names of fire-alarm.wording beside it.

declare Sprinkler
    room : String
    on : boolean
end

declare Fire
    room : String
end

declare Alarm
    active : String
end

rule "When there is a fire turn on the sprinkler"
    when
        Fire( room : room )
        s : Sprinkler( room == room, on == false )
    then
        modify( s ) { on = true }
end

rule "Raise the alarm when we have one or more fires"
    when
        Fire( room : room )
        not Alarm( active == yes )
    then
        insert(new Alarm(yes))
end

rule "Cancel the alarm when all the fires have gone"
    when
        not Fire( room : room )
        Alarm( active == yes )
    then
        retract(new Alarm(yes))
end
