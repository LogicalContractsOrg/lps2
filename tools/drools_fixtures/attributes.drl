// Rule attributes: what LPS can say (no-loop, enabled false) and what it
// cannot (lock-on-active beyond no-loop, agenda-group, a calendar, a timer).
// Checked against Drools 10: `cap the balance` and `flag an overdrawn
// account` fire once each, `count once` once (k ends at 1), `switched off`
// and `in a group` never.
package fixtures;

declare Account
    id : String
    balance : int
    flagged : boolean
end

declare Counter
    name : String
    count : int
end

declare Note
    text : String
end

// no-loop: its modify keeps its conditions true, and Drools does not fire
// it again because of its own change. Without no-loop it fires for ever.
rule "cap the balance"
    no-loop true
    when
        $a : Account( balance >= 100 )
    then
        modify( $a ) { setBalance( 100 ) };
end

rule "flag an overdrawn account"
    lock-on-active
    when
        $a : Account( balance < 0 )
    then
        modify( $a ) { setFlagged( true ) };
end

// no-loop over a change computed from the old value: not translated.
rule "count once"
    no-loop
    when
        $c : Counter( count < 5 )
    then
        modify( $c ) { setCount( $c.getCount() + 1 ) };
end

rule "switched off"
    enabled false
    when
        Account( balance < 0 )
    then
        insert( new Note( "never" ) );
end

rule "in a group"
    agenda-group "audit"
    date-expires "01-Jan-2020"
    timer ( int: 1s )
    dialect "mvel"
    when
        Account( balance == 0 )
    then
        insert( new Note( "empty" ) );
end
