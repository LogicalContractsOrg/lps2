// `or` between patterns: Drools makes one subrule per alternative.
declare Person
    name : String
    age : int
end

declare Flag
    name : String
end

rule "the young and the old are flagged"
    when
        Person( name : name, age < 18 ) or Person( name : name, age > 65 )
        not Flag( name == name )
    then
        insert(new Flag(name))
end

rule "a quiet day has no child and no pensioner"
    when
        Day( d : d )
        not( Person( age < 18 ) or Person( age > 65 ) )
    then
        insert(new Quiet(d))
end

declare Day
    d : String
end

declare Quiet
    d : String
end
