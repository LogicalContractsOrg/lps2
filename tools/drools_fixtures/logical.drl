// insertLogical: the fact holds for as long as its support does.
declare Light
    room : String
    on : boolean
end

declare Lit
    room : String
end

declare Dark
    room : String
end

rule "a room with its light on is lit"
    when
        Light( room : room, on == true )
    then
        insertLogical(new Lit(room))
end

rule "lights go off"
    when
        l : Light( on == true )
    then
        modify( l ) { on = false }
end

rule "a room that is not lit is dark"
    when
        Light( room : room )
        not Lit( room == room )
    then
        insert(new Dark(room))
end
